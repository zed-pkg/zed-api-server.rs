# zed-api-server.rs environment schema — names and meanings only, never real
# secret values. Real values live encrypted in env/enc/<name>.env.enc
# (sops + age). Edit with `just edit <name>`; activate with `just use <name>`.
#
# The server is flags-2-env style: src/config.rs is the single parse point,
# plus a handful of module-local operational knobs listed at the bottom.
# README "Configuration (env)" is the authoritative defaults table.

# --- Core --------------------------------------------------------------------
# Listen address. Non-secret; default 0.0.0.0:8080.
BIND_ADDR=0.0.0.0:8080
# Postgres DSN. REQUIRED. SECRET in any shared environment (embeds password);
# the local docker-compose value is a throwaway.
DATABASE_URL=EXAMPLE-postgres://zed:zed@localhost:5432/zed
# Run migration/ on boot. Non-secret; default true.
AUTO_MIGRATE=true
# Advertised base for download URLs. Non-secret. Prod: https://registry.zpkg.net
PUBLIC_BASE_URL=http://localhost:8080
# Stable logical identity embedded in dependency-graph nodes. Non-secret. This
# must survive domain/ingress changes; self-hosted registries should assign a
# unique `registry:<slug>` value before publishing graph artifacts.
ZED_REGISTRY_ID=registry:zpkg-primary

# --- Storage backend ---------------------------------------------------------
# memory | local | s3. Non-secret; default local.
STORAGE_BACKEND=local
# local backend only. Non-secret; default .data/artifacts.
STORAGE_LOCAL_DIR=.data/artifacts
# memory backend only: hard byte cap, must be > 0. Non-secret; default 268435456.
#STORAGE_MEMORY_MAX_BYTES=268435456

# --- S3 / Cloudflare R2 (STORAGE_BACKEND=s3) ---------------------------------
# Bucket name — identifier, not a secret. Prod bucket: zed-pkg-artifacts
# (managed in zed-infra/terraform/cloudflare).
S3_BUCKET=zed-pkg-artifacts
# R2: https://<account_id>.r2.cloudflarestorage.com — account id is an
# identifier, safe in plaintext. MinIO (docker-compose): http://localhost:9000.
S3_ENDPOINT_URL=EXAMPLE-https://your-account-id.r2.cloudflarestorage.com
# R2 uses `auto`. Non-secret; default auto.
S3_REGION=auto
# MinIO needs it; harmless on R2. Non-secret; default true.
S3_FORCE_PATH_STYLE=true
# Read by the AWS SDK default provider chain (not parsed in config.rs).
# Access Key ID is the R2 token id — an identifier. The Secret Access Key is a
# SECRET (for R2 it is literally sha256 of the API token — treat any exposure
# as full token compromise). Mint in the Cloudflare dashboard and enter via
# `just edit <name>` ONLY — a value that transits chat, a shell command, or a
# plaintext file is burned and must be revoked (credential policy / DEN-2836).
AWS_ACCESS_KEY_ID=EXAMPLE-r2-access-key-id
AWS_SECRET_ACCESS_KEY=EXAMPLE-mint-in-dashboard-enter-via-just-edit

# --- Tag verification --------------------------------------------------------
# off | github. Non-secret; default off.
ZED_VERIFY_TAGS=off
# Optional; raises GitHub tag-check rate limits when ZED_VERIFY_TAGS=github.
# SECRET. Fine-grained, read-only, expiring token; never a classic PAT.
#GITHUB_TOKEN=EXAMPLE-mint-fine-grained-enter-via-just-edit

# --- Fiducia distributed locks (optional; absent => Postgres-only fallback) --
# Lock service URL. Non-secret.
#FIDUCIA_URL=EXAMPLE-https://fiducia.example
# x-fiducia-internal-auth secret for direct-to-node calls. SECRET.
#FIDUCIA_INTERNAL_SECRET=EXAMPLE-enter-via-just-edit
# Org identifier within fiducia. Non-secret; default zed-registry.
#FIDUCIA_ORG_ID=zed-registry

# --- Limits and tuning (all non-secret, all defaulted) -----------------------
# Request body cap. Default 104857600.
MAX_ARTIFACT_BYTES=104857600
# Org-creation cap per token. Default 5.
ZED_MAX_ORGS_PER_TOKEN=5
# Connection pool size. Default 10.
DB_MAX_CONNECTIONS=10
# Startup DB retry deadline (server.rs). Default 30.
#DB_CONNECT_MAX_WAIT_SECS=30
# Abuse-ceiling rate limiter (ratelimit.rs). Defaults 60 / 10.
#ZED_RATE_LIMIT_BURST=60
#ZED_RATE_LIMIT_PER_SECOND=10
# Memory budget for artifact-buffering endpoints (routes/mod.rs). Default 256 MiB.
#ZED_ARTIFACT_SERVE_MEMORY_BUDGET_BYTES=268435456
# Independent budget for dependency-graph encoding. Default 256 MiB.
#ZED_GRAPH_SERVE_MEMORY_BUDGET_BYTES=268435456
# Archive-inflation cap for file serving (files.rs). Default 536870912.
#ZED_MAX_INFLATED_BYTES=536870912
# Log filter. Non-secret; default info.
RUST_LOG=info

# --- Test-only / bootstrap knobs (never set in a durable environment) --------
# ZED_AUTH_DISABLED=1        loud opt-in bootstrap mode: no bearer auth
# ZED_RATE_LIMIT_DISABLED=1  disables the abuse ceiling
# Both appear in k8s/base/deployment.yaml only as the marked TEMPORARY
# bootstrap posture; they are deliberately excluded from env/enc/*.env.enc.
