/target
/.data
/.formal-artifacts
/.formal-tools
/.vendor/.zed/
/_apalache-out

# Local secrets. Provider credentials enter this repo only as sops ciphertext
# under env/enc/*.env.enc. Plaintext never gets committed.
# The repo-root .env is a symlink into env/dec/ created by `just use <name>`.
.env
.env.*
*.env
**/*.env
env/dec
env/dec/*
!env/enc/
!env/enc/*.env.enc
!env/template.env.example

# nix devShell artifacts
.direnv/
result
result-*
tmp
temp
tmp/worktrees
temp/worktrees

# ores-sops dotenv hardening: plaintext dotenv is local-only at every depth;
# only env/enc/*.env.enc (sops ciphertext) is tracked. See env/README.md.
**/**/*.env
